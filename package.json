{
  "name": "applied-ai-command-center",
  "version": "0.6.0-alpha.2",
  "description": "Foxsocket personal AI workspace with Sparky",
  "license": "MIT",
  "author": "Applied AI Solutions",
  "main": "main.js",
  "scripts": {
    "start": "node build-ui.mjs && electron .",
    "package": "node build-ui.mjs && electron-builder --config electron-builder.cjs --win dir",
    "dist": "node build-ui.mjs && node build/render-maker.cjs && electron-builder --config electron-builder.cjs --win nsis",
    "build:ui": "node build-ui.mjs",
    "test:ui": "node build-ui.mjs && electron workspace-smoke.cjs",
    "test:setup": "node --test setup.test.cjs",
    "render:maker": "node build/render-maker.cjs",
    "update:local": "powershell -NoProfile -ExecutionPolicy Bypass -File build/update-local.ps1",
    "test:updates": "node --test updates.test.cjs",
    "test:host": "node --test host-manager.test.cjs"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4"
  },
  "build": {
    "appId": "solutions.appliedai.commandcenter",
    "productName": "Applied AI Command Center",
    "files": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "main.js",
      "setup.js",
      "docs/fresh-pc-setup.md",
      "preload.js",
      "index.html",
      "app.js",
      "style.css",
      "assets/**/*",
      "lighting.js",
      "polish.css",
      "finish.css",
      "finish.js",
      "branding.js",
      "brand-ui.js",
      "workspace.css",
      "workspace.js",
      "workspace-main.js",
      "updates.js",
      "updates-main.js",
      "updates-ui.js",
      "host-main.js",
      "host-manager.js",
      "host-ui.js",
      "host-ui.css",
      "build/host-startup.ps1",
      "starter-agent.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Foxsocket.Setup.${version}.${ext}",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "animejs": "^4.5.0",
    "motion": "^13.2.0",
    "openrgb-sdk": "^0.6.0"
  }
}
